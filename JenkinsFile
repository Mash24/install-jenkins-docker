pipeline {
    agent any

    stages {
        stage('Build') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps {
                dir('learn-jenkins-app') {
                    sh '''
                        ls -la
                        node --version
                        npm --version
                        npm install
                        npm run build
                        ls -la build
                    '''
                }
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'learn-jenkins-app/build/**', fingerprint: true
        }
    }
}
